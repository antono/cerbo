{ pkgs, tauri-deps }:
let
  # fastembed loads ONNX Runtime at run time (ort `load-dynamic`); the binaries
  # find it through this variable unless the user sets their own.
  ortDylibPath = "${pkgs.onnxruntime}/lib/libonnxruntime.so";

  cerbo = pkgs.rustPlatform.buildRustPackage {
    pname = "cerbo";


    version = "0.1.0";
    src = ../.;
    cargoLock.lockFile = ../Cargo.lock;
    # Build only the CLI crate: without -p, cargo builds the whole workspace
    # and the install hook would copy the desktop binary in as well.
    cargoBuildFlags = [ "-p" "cerbo" ];
    cargoTestFlags = [ "-p" "cerbo" "-p" "cerbo-core" ];
    # bindgenHook provides libclang for oxigraph's bundled RocksDB.
    nativeBuildInputs = [
      pkgs.pkg-config
      pkgs.mandown
      pkgs.makeWrapper
      pkgs.rustPlatform.bindgenHook
    ];
    # Network-dependent tests are #[ignore]d; the rest run in the sandbox.
    doCheck = true;
    # Imports shell out to curl; the import-ontology tests fetch file:// URLs.
    nativeCheckInputs = [ pkgs.curl ];

    # Install man page generated by build.rs from cli/man/cerbo.md via mandown.
    # Cargo puts build-script output under target/<triple>/release when a target
    # is set and target/release when it is not, so look in both.
    postInstall = ''
      mkdir -p $out/share/man/man1
      manPage=
      for dir in target/*/release/build/cerbo-*/out target/release/build/cerbo-*/out; do
        if [ -f "$dir/cerbo.1" ]; then
          manPage="$dir/cerbo.1"
          break
        fi
      done
      if [ -z "$manPage" ]; then
        echo "ERROR: cerbo.1 not found in build output (mandown should be available)" >&2
        exit 1
      fi
      cp "$manPage" $out/share/man/man1/

      wrapProgram $out/bin/cerbo --set-default ORT_DYLIB_PATH ${ortDylibPath}
    '';
  };

  cerbo-frontend = pkgs.stdenv.mkDerivation {
    pname = "cerbo-frontend";


    version = "0.1.0";
    src = ../.;
    nativeBuildInputs = [
      pkgs.bun
      pkgs.bun2nix.hook
    ];
    bunDeps = pkgs.bun2nix.fetchBunDeps {
      bunNix = ./bun.nix;
      src = ../.;
    };
    buildPhase = ''
      bun install --no-save
      bun run build
    '';
    installPhase = ''
      mkdir -p $out
      cp -r build/* $out
    '';
  };

  cerbo-desktop = pkgs.rustPlatform.buildRustPackage {
    pname = "cerbo-desktop";


    version = "0.1.0";
    src = ../.;
    cargoLock.lockFile = ../Cargo.lock;
    # Build and test only the desktop crate; the CLI and core tests run in
    # the `cerbo` package above, which this one depends on.
    cargoBuildFlags = [ "-p" "cerbo-desktop" ];
    cargoTestFlags = [ "-p" "cerbo-desktop" ];
    nativeBuildInputs = [
      pkgs.pkg-config
      pkgs.wrapGAppsHook3
      pkgs.gobject-introspection
      pkgs.jq
      pkgs.desktop-file-utils
      pkgs.rustPlatform.bindgenHook
    ];
    buildInputs = tauri-deps ++ [ pkgs.gtk3 pkgs.gsettings-desktop-schemas pkgs.adwaita-icon-theme ];

    postPatch = ''
      # Nullify devUrl and point frontendDist to the built frontend in the Nix store
      jq '.build.devUrl = null | .build.frontendDist = "${cerbo-frontend}"' src-tauri/tauri.conf.json > src-tauri/tauri.conf.json.tmp
      mv src-tauri/tauri.conf.json.tmp src-tauri/tauri.conf.json
    '';

    # Ensure Tauri doesn't try to use a dev server
    TAURI_ENV_DEBUG = "false";

    # wrapGAppsHook3 already wraps the binary; add ONNX Runtime to that wrapper.
    preFixup = ''
      gappsWrapperArgs+=(--set-default ORT_DYLIB_PATH ${ortDylibPath})
    '';

    # Launch script: bring every registered vault into the schema.org
    # vocabulary, then start the app. The GApps wrapper here is a binary one,
    # which has no --run, so it moves to libexec and a shell script takes its
    # place. The check is cached (a stat per file once a vault is current) and
    # repeats on every start, because an old Cerbo on another device can sync
    # old-format files in at any time. Its output goes to stderr, and a failure
    # never keeps the app from starting: the app reads the old format too.
    # `exec -a "$0"` keeps argv[0] ending in cerbo-desktop, which the window's
    # app_id and the .desktop entry's StartupWMClass depend on.
    postFixup = ''
      mkdir -p $out/libexec
      mv $out/bin/cerbo-desktop $out/libexec/cerbo-desktop
      cat > $out/bin/cerbo-desktop <<EOF
    #!${pkgs.runtimeShell}
    ${cerbo}/bin/cerbo migrate vocabulary --if-needed >&2 || true
    exec -a "\$0" $out/libexec/cerbo-desktop "\$@"
    EOF
      chmod +x $out/bin/cerbo-desktop
    '';

    # The launcher is shell glue that no Rust test runs, and postFixup must
    # come after wrapGAppsHook3's fixup: check the result. installCheck runs
    # after fixup, on the finished $out.
    doInstallCheck = true;
    installCheckPhase = ''
      runHook preInstallCheck
      launcher=$out/bin/cerbo-desktop
      ${pkgs.runtimeShell} -n "$launcher"
      grep -qF '${cerbo}/bin/cerbo migrate vocabulary --if-needed >&2 || true' "$launcher"
      grep -qF "exec -a \"\$0\" $out/libexec/cerbo-desktop \"\$@\"" "$launcher"
      # What the launcher execs is the GApps wrapper, with ONNX Runtime set.
      test -x $out/libexec/cerbo-desktop
      grep -qa XDG_DATA_DIRS $out/libexec/cerbo-desktop
      grep -qa ORT_DYLIB_PATH $out/libexec/cerbo-desktop

      # Run it with stand-ins: the migration first, its output on stderr only,
      # and the app starts with its arguments even when the migration fails.
      # The app stand-in is a script: `exec -a` renames argv[0], which would
      # confuse a multi-call coreutils binary.
      printf '#!%s\necho started "$@"\n' ${pkgs.runtimeShell} > fake-app
      chmod +x fake-app
      for migration in "${pkgs.coreutils}/bin/echo migrating" ${pkgs.coreutils}/bin/false; do
        sed -e "s|${cerbo}/bin/cerbo|$migration|" \
            -e "s|$out/libexec/cerbo-desktop|$PWD/fake-app|" \
            "$launcher" > fake-launcher
        chmod +x fake-launcher
        out_text=$(./fake-launcher 137 2> fake-stderr)
        test "$out_text" = "started 137"
        case "$migration" in
          *echo*) grep -qxF 'migrating migrate vocabulary --if-needed' fake-stderr ;;
        esac
      done
      runHook postInstallCheck
    '';

    postInstall = ''
      # Install desktop file. Its basename and StartupWMClass must equal the
      # program name (Wayland app_id and X11 WM_CLASS are both "cerbo-desktop"),
      # otherwise shells cannot match running windows to this entry and icon.
      mkdir -p $out/share/applications
      cp src-tauri/cerbo-desktop.desktop $out/share/applications/
      desktop-file-validate $out/share/applications/cerbo-desktop.desktop

      # Install icons
      mkdir -p $out/share/icons/hicolor/scalable/apps
      cp src-tauri/icons/logo.svg $out/share/icons/hicolor/scalable/apps/cerbo-desktop.svg

      # Install fixed-size icons
      for size in 32 64 128; do
        mkdir -p $out/share/icons/hicolor/''${size}x''${size}/apps
        cp src-tauri/icons/''${size}x''${size}.png $out/share/icons/hicolor/''${size}x''${size}/apps/cerbo-desktop.png
      done
      mkdir -p $out/share/icons/hicolor/256x256/apps $out/share/icons/hicolor/512x512/apps
      cp src-tauri/icons/128x128@2x.png $out/share/icons/hicolor/256x256/apps/cerbo-desktop.png
      cp src-tauri/icons/icon.png $out/share/icons/hicolor/512x512/apps/cerbo-desktop.png
    '';
  };
  # Not in nixpkgs. Bridges WebdriverIO to WebKitWebDriver for e2e tests.
  tauri-driver = pkgs.rustPlatform.buildRustPackage rec {
    pname = "tauri-driver";
    version = "2.1.0";
    src = pkgs.fetchCrate {
      inherit pname version;
      hash = "sha256-Ttik3t/IUnze3SHcpH9zPS1UwW9B/V70Wvel+eBHhOE=";
    };
    cargoHash = "sha256-x7cz2KLNLJRlPqahV/BwyYJcncfUyhIp6/gORhvudZI=";
  };
in
{
  inherit cerbo cerbo-frontend cerbo-desktop tauri-driver;
}
